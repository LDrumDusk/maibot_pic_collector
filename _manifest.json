{
  "manifest_version": 2,
  "id": "com.maimai.pic-collector",
  "version": "1.0.1",
  "name": "聊天图片收藏",
  "description": "有选择性地保存聊天记录图片：根据 bot 人设或用户自定义要求，用文字 LLM（回复模型）判断主程序已生成的图片识别文字，符合条件的原图按日期保存到指定目录，保存后随机发送一条通知。",
  "author": {
    "name": "LDrumDusk",
    "url": "https://github.com/LDrumDusk"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/LDrumDusk/maibot_pic_collector",
    "homepage": "https://github.com/LDrumDusk/maibot_pic_collector",
    "documentation": "https://github.com/LDrumDusk/maibot_pic_collector/blob/main/README.md",
    "issues": "https://github.com/LDrumDusk/maibot_pic_collector/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.0"
    }
  ],
  "plugin_type": "tool",
  "capabilities": [
    "config.get",
    "llm.generate",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
